# Copy to .streamlit/secrets.toml for local dev (never commit secrets.toml).
# Streamlit Cloud: paste the same keys in App → Settings → Secrets.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
# Password reset redirect (must match Supabase Auth → URL configuration)
AUTH_REDIRECT_URL = "http://localhost:8501"
